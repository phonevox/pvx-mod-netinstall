#!/usr/bin/env bash
# hooks/update — no-op real (registra a chamada). Atualiza o CÓDIGO do módulo em si (ciclo de
# vida do pvx-core sobre o módulo); não tem relação com re-rodar uma instalação já feita no PBX.
set -Eeuo pipefail
: "${PVX_MODULE_STATE_DIR:?PVX_MODULE_STATE_DIR não definido}"
mkdir -p "$PVX_MODULE_STATE_DIR"
ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf '?')
printf 'update %s -> %s %s\n' "${PVX_MODULE_OLD_VERSION:-?}" "${PVX_MODULE_VERSION:-?}" "$ts" \
  >>"$PVX_MODULE_STATE_DIR/hooks.log"
exit 0
