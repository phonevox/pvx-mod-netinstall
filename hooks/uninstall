#!/usr/bin/env bash
# hooks/uninstall — no-op real (registra a chamada). Remove só o módulo em si (comando,
# symlink, estado) — nunca desfaz uma instalação de PBX já feita na máquina.
set -Eeuo pipefail
: "${PVX_MODULE_STATE_DIR:?PVX_MODULE_STATE_DIR não definido}"
mkdir -p "$PVX_MODULE_STATE_DIR"
ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf '?')
printf 'uninstall %s %s\n' "${PVX_MODULE_VERSION:-?}" "$ts" >>"$PVX_MODULE_STATE_DIR/hooks.log"
exit 0
